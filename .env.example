# MLSU simulator — supported environment variables.
#
# These are read from the process environment (server.ts), not from a .env
# file: the project has no dotenv loader on purpose, so that running it needs
# no extra dependency. Either export them in your shell,
#
#   PORT=3000 HOST=0.0.0.0 npm run dev
#
# or let docker-compose.yml pass them in. This file documents the variables
# and their defaults; copying it to .env alone has no effect.

# TCP port the Express server listens on (default: 3000)
PORT=3000

# Interface to bind to (default: 0.0.0.0 — all interfaces)
HOST=0.0.0.0

# "production" serves the built assets from dist/client;
# anything else runs Vite in middleware mode (default: development)
NODE_ENV=development
